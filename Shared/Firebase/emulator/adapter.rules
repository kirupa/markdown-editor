rules_version = '2';

// Rules for the *adapter* check only. Never deployed.
//
// Shared/Firebase/Sources/firebase-emulator-check runs unauthenticated,
// because FirebaseAuth cannot sign in from a SwiftPM executable on macOS: it
// persists to the data-protection keychain, which needs the restricted
// `keychain-access-groups` entitlement, and a binary that claims that
// entitlement without a provisioning profile is SIGKILLed at exec.
//
// That is fine for what this check is for. It asks whether
// `FirestoreNodeStore` speaks Firestore correctly — field names, the subtree
// range query's filter, batch atomicity, listener delivery — none of which is
// a question about who is allowed to do it.
//
// Who is allowed is the shipped rules' job, and those are verified against the
// real rules engine by Web/firebase/check-rules.mjs, including the
// cross-account refusals. Rules are one artifact shared by every client, so
// they are tested once rather than once per platform.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
